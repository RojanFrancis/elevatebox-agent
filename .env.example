# Copy to .env, fill in real values, then run:
#   set -a; source .env; set +a; ./mvnw spring-boot:run
# NEVER commit the real .env file.

# -- Auth for this service (generate each with: openssl rand -hex 32) ------------
APP_API_KEY=                   # you send this as the X-API-Key header on /api/call/* (not /health)
VAPI_WEBHOOK_SECRET=           # Vapi sends this on /api/call/webhook; set the same value in the Vapi Server URL credential

# -- Vapi ------------------------------------------------------------------------
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=          # Vapi dashboard -> Phone Numbers -> copy ID (your imported Twilio number)
VAPI_ASSISTANT_ID=             # leave blank to use the inline assistant in code
VAPI_TARGET_PHONE=             # E.164 format, the number the agent dials

# -- Meta WhatsApp Cloud API -----------------------------------------------------
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_TARGET_PHONE=         # a verified test number in E.164 format

# -- Gemini ----------------------------------------------------------------------
GEMINI_API_KEY=                # AI Studio key (starts with AIza)
# GEMINI_MODEL=                # optional, defaults to gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=      # optional, comma-separated models to try if the main one fails

# -- Shown in the post-call WhatsApp ---------------------------------------------
AGENT_PHONE=                   # required, no default
# AGENT_NAME=
# AGENT_RESUME_LINK=
# AGENT_BUILD_IMAGE_URL=
# AGENT_BROCHURE_URL=          # link sent in the mid-call WhatsApp

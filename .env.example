# Copy to .env, fill in real values, and run:  set -a; source .env; set +a; ./mvnw spring-boot:run
# NEVER commit the real .env file.

# ── Vapi ─────────────────────────────────────────────────────────────────────
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=          # Vapi dashboard -> Phone Numbers -> copy ID
VAPI_ASSISTANT_ID=             # leave blank to use the inline assistant in code
VAPI_TARGET_PHONE=+919514971623
VAPI_SERVER_URL=               # https://<your-ngrok>.ngrok-free.app/api/call/webhook
VAPI_LOG_FULL_PAYLOAD=true     # set false after webhooks are confirmed working

# ── ElevenLabs (register the key inside Vapi -> Provider Keys too) ────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=sarah      # replace with a voice ID from elevenlabs.io/voice-library

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_TARGET_PHONE=+919514971623   # YOUR verified test number, not the lead's
WHATSAPP_FALLBACK_TEMPLATE=           # optional approved template name

# ── Gemini ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                # must be an AI Studio key starting with AIza
